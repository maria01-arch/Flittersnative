<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A voice call keeps the microphone running while the app is in the background. Android only allows
       that from a "foreground service" of the microphone type, shown as an ongoing notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <application>
    <service
      android:name="expo.modules.flitterscall.CallService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
